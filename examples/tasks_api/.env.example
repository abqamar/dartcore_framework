APP_NAME=tasks_api
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
APP_DEBUG=true

# PostgreSQL (use DB_DRIVER=sqlite and DB_DATABASE=storage/database.sqlite to run without a server)
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tasks_api
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_SSL=disable

# Generate with: openssl rand -base64 48   (must be at least 32 bytes)
JWT_SECRET=
